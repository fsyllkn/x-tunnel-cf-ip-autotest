# Output path for the local sing-box node provider.
# Relative paths are resolved against the project directory.
# The default is runtime/x-tunnel-provider.json.
# Configure ShellCrash's local provider entry manually to reference this path.
X_TUNNEL_PROVIDER_PATH=runtime/x-tunnel-provider.json

# Dedicated X-Tunnel Go kernel UID/GID on OpenWrt (default 29002).
# Only kernel child processes use this identity. Supervisor, Telegram Bot,
# provider writer and CF speed tests remain root when launched by procd.
# Choose an unused UID; sing-box eBPF local.exclude_uid must match.
X_TUNNEL_PROCESS_UID=29002

# Optional SOCKS5 listener override (comma-separated numeric IP addresses).
# EMPTY means: use defaults.listen_hosts from x-tunnel.yaml.
# The YAML template defaults to 127.0.0.1 only (safe local-only listener).
# Set this variable to override YAML, e.g. 127.0.0.1,192.168.68.11.
# LAN SOCKS5 has no authentication: restrict clients using the LAN firewall.
X_TUNNEL_LISTEN_HOSTS=

# Optional Telegram HTTP proxy, e.g. http://proxy-host:7890.
# Empty uses the local proxy below; no LAN address is hard-coded.
X_TUNNEL_TG_PROXY=
X_TUNNEL_LOCAL_PROXY=http://127.0.0.1:7890

# Primary CF IP speed-test target in Mbps; pass count remains two.
X_TUNNEL_TARGET_MBPS=300
