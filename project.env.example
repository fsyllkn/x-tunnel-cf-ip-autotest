# Output path for the local sing-box node provider.
# Relative paths are resolved against the project directory.
# The default is runtime/x-tunnel-provider.json.
# Configure ShellCrash's local provider entry manually to reference this path.
X_TUNNEL_PROVIDER_PATH=runtime/x-tunnel-provider.json

# Optional SOCKS5 listener addresses. Empty means localhost only.
# Set the server's actual LAN address to enable LAN access.
X_TUNNEL_LISTEN_HOSTS=

# Optional Telegram HTTP proxy, e.g. http://proxy-host:7890.
# Empty uses the local proxy below; no LAN address is hard-coded.
X_TUNNEL_TG_PROXY=
X_TUNNEL_LOCAL_PROXY=http://127.0.0.1:7890

# Primary CF IP speed-test target in Mbps; pass count remains two.
X_TUNNEL_TARGET_MBPS=300
