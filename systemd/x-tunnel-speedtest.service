[Unit]
Description=Cloudflare IP speed test for X-Tunnel
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_DIR@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=X_TUNNEL_BOT_CONFIG=@PROJECT_DIR@/speedtest-bot.env
EnvironmentFile=-@PROJECT_DIR@/project.env
ExecStart=/usr/bin/python3 @PROJECT_DIR@/cfip_speedtest.py
TimeoutStartSec=infinity
