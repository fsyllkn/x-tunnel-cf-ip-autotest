# Managed-by: x-tunnel-cf-ip-autotest (lxc/systemd)
[Unit]
Description=Cloudflare IP speed test for X-Tunnel
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_DIR@
ExecCondition=/usr/bin/python3 @PROJECT_DIR@/config_ready.py
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 @PROJECT_DIR@/cfip_speedtest.py
TimeoutStartSec=infinity
