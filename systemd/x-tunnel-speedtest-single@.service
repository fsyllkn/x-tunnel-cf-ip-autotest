# Managed-by: x-tunnel-cf-ip-autotest (lxc/systemd)
[Unit]
Description=Single Cloudflare IP speed test for X-Tunnel (%I)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_DIR@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 @PROJECT_DIR@/cfip_speedtest.py --single-ip %I
TimeoutStartSec=infinity
