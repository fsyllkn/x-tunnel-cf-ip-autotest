# Managed-by: x-tunnel-cf-ip-autotest (lxc/systemd)
[Unit]
Description=Dedicated Telegram bot adapter for X-Tunnel speed tests
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
ExecCondition=/usr/bin/python3 @PROJECT_DIR@/bot_ready.py
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 @PROJECT_DIR@/telegram_speedtest_bot.py
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
