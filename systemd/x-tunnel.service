# Managed-by: x-tunnel-cf-ip-autotest (lxc/systemd)
[Unit]
Description=X-Tunnel client supervisor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
# Exit 10 (unconfigured) skips start without triggering Restart=always.
ExecCondition=/usr/bin/python3 @PROJECT_DIR@/config_ready.py
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 @PROJECT_DIR@/supervisor.py
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
