[Unit]
Description=X-Tunnel client supervisor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-@PROJECT_DIR@/project.env
ExecStart=/usr/bin/python3 @PROJECT_DIR@/supervisor.py
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
